# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp env.example .env

# Where the SQLite database lives. Relative paths resolve from the project root.
DATABASE_PATH=data/app.db

# Server
PORT=3000
# 0.0.0.0 makes the app reachable from other devices on the home Wi-Fi.
# On a public server use 127.0.0.1, so only the HTTPS proxy in front of it can
# reach it (see DEPLOY.md).
HOST=0.0.0.0

# Who may sign up, and who may use the AI tutor: an "email,ai" header, then
# lines like you@example.com,yes. Edits apply without a restart; missing or
# empty means nobody can.
# ALLOWLIST_PATH=allowed_emails.csv

# ---------------------------------------------------------------------------
# Conversation practice
# ---------------------------------------------------------------------------
# Which AI answers. One of: anthropic | openai | none
# Leave unset and it uses whichever key is present, preferring Anthropic.
#
# An API key is billed per use, separately from any Claude or ChatGPT
# subscription. Create one at console.anthropic.com (or platform.openai.com).
AI_PROVIDER=anthropic

# Optional. Overrides the provider's default model.
#   anthropic defaults to claude-opus-5 — the most capable and the priciest;
#             claude-sonnet-5 or claude-haiku-4-5-20251001 cost far less
#   openai defaults to    gpt-4o-mini
# AI_MODEL=claude-sonnet-5

# Set the key for whichever provider you chose.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Check it works before relying on it:  npm run ai:check
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Sending email (password resets)
# ---------------------------------------------------------------------------
# With none of this set, a reset link is written to the server log instead of
# being sent. That is fine for a laptop — the whole flow works — but on a real
# server it means only somebody reading the log can reset a password, which is
# the problem this feature exists to solve. Set SMTP_HOST to send for real.
#
# console | smtp. Leave unset and SMTP_HOST decides.
# EMAIL_PROVIDER=smtp

# Gmail: use an App Password, not your account password. It needs 2-Step
# Verification turned on, then myaccount.google.com/apppasswords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# Port 465 is implicit TLS, 587 upgrades with STARTTLS. Defaults from the port.
# SMTP_SECURE=false

# What the email is sent from. Defaults to SMTP_USER.
# EMAIL_FROM=Lingo <you@gmail.com>

# The origin links in emails point at. **Set this in production.** Without it
# the link is built from the request's own Host header, which is the classic
# way a reset email is turned into a credential thief.
# APP_URL=https://91-99-202-188.sslip.io
# ---------------------------------------------------------------------------

# info | debug | warn | error
LOG_LEVEL=info
