# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp env.example .env

# Where the SQLite database lives. Relative paths resolve from the project root.
DATABASE_PATH=data/app.db

# Server
PORT=3000
# 0.0.0.0 makes the app reachable from other devices on the LAN (needed on the Pi).
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Conversation practice
# ---------------------------------------------------------------------------
# Which AI answers. One of: openai | anthropic | none
# Leave unset and it uses whichever key is present, preferring OpenAI.
AI_PROVIDER=openai

# Optional. Overrides the provider's default model.
#   openai defaults to    gpt-4o-mini
#   anthropic defaults to claude-opus-5
# AI_MODEL=gpt-4o-mini

# Set the key for whichever provider you chose.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Check it works before relying on it:  npm run ai:check
# ---------------------------------------------------------------------------

# info | debug | warn | error
LOG_LEVEL=info
