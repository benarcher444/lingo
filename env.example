# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp env.example .env

# Where the SQLite database lives. Relative paths resolve from the project root.
DATABASE_PATH=data/app.db

# Server
PORT=3000
# 0.0.0.0 makes the app reachable from other devices on the home Wi-Fi.
# On a public server use 127.0.0.1, so only the HTTPS proxy in front of it can
# reach it (see DEPLOY.md).
HOST=0.0.0.0

# Who may sign up: one email address per line. Edits apply without a restart;
# missing or empty means nobody can. Template: allowed_emails.example.csv
# ALLOWLIST_PATH=allowed_emails.csv

# ---------------------------------------------------------------------------
# Conversation practice
# ---------------------------------------------------------------------------
# Which AI answers. One of: anthropic | openai | none
# Leave unset and it uses whichever key is present, preferring Anthropic.
#
# An API key is billed per use, separately from any Claude or ChatGPT
# subscription. Create one at console.anthropic.com (or platform.openai.com).
AI_PROVIDER=anthropic

# Optional. Overrides the provider's default model.
#   anthropic defaults to claude-opus-5 — the most capable and the priciest;
#             claude-sonnet-5 or claude-haiku-4-5-20251001 cost far less
#   openai defaults to    gpt-4o-mini
# AI_MODEL=claude-sonnet-5

# Set the key for whichever provider you chose.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Check it works before relying on it:  npm run ai:check
# ---------------------------------------------------------------------------

# info | debug | warn | error
LOG_LEVEL=info
