# Nightly database backup at 03:30 server time. Persistent: if the server was
# off at 03:30, it runs at the next boot instead.
# Install:  cp deploy/lingo-backup.* /etc/systemd/system/ && systemctl enable --now lingo-backup.timer

[Unit]
Description=Nightly Lingo database backup

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
