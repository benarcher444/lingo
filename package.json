{
  "name": "lingo",
  "version": "0.1.0",
  "description": "Lingo — a personal language-learning web app: vocabulary, spaced testing, listening, conversation and progress tracking.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "shot": "tsx scripts/screenshot.ts",
    "test": "tsx scripts/test-algorithm.ts",
    "audit:mobile": "tsx scripts/audit-mobile.ts",
    "test:entry": "tsx scripts/test-fast-entry.ts",
    "ai:check": "tsx scripts/check-ai.ts",
    "reset:users": "tsx scripts/reset-users.ts",
    "test:ai": "tsx scripts/test-ai-config.ts",
    "test:accents": "tsx scripts/test-accents.ts",
    "test:accents:browser": "tsx scripts/test-accents-browser.ts",
    "seed:clean": "tsx scripts/remove-demo-accounts.ts",
    "set-password": "tsx scripts/set-password.ts",
    "unlock": "tsx scripts/unlock-account.ts",
    "backup": "tsx scripts/backup-db.ts",
    "test:search": "tsx scripts/test-vocab-search.ts",
    "test:session": "tsx scripts/test-session-setup.ts",
    "test:listening": "tsx scripts/test-listening.ts",
    "test:vocab-edit": "tsx scripts/test-vocab-edit.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:all": "npm run test && npm run test:accents && npm run test:ai && npm run test:auth && npm run test:search && npm run test:session && npm run test:listening && npm run test:vocab-edit && npm run test:entry",
    "test:daily": "tsx scripts/test-daily-count.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "openai": "^7.10.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benarcher444/lingo.git"
  }
}
